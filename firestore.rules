rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is logged in
    function isLoggedIn() {
      return request.auth != null;
    }

    // Helper to check if the current user matches the target uid
    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }
    
    // Helper to check if the user is an admin
    function isAdmin() {
      return isLoggedIn() && (
        request.auth.token.email == "contato@triangulofotoclub.com.br" ||
        request.auth.token.email == "kakatdb@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // Rules for Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Rules for Bookings collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Rules for Settings collection (Simulator & Prices)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Rules for Messages collection (Chat)
    match /messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Rules for Testimonials collection
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Rules for Spaces collection
    match /spaces/{spaceId} {
      allow read: if true;
      allow write: if true;
    }

    // Rules for Cowork Plans collection
    match /cowork_plans/{planId} {
      allow read: if true;
      allow write: if true;
    }

    // Rules for Site Settings collection
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Rules for Equipment collection
    match /equipment/{equipId} {
      allow read: if true;
      allow write: if true;
    }

    // Rules for Security Logs collection
    match /security_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // Rules for Activity Logs collection
    match /activity_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // Rules for Behavioral Click Analytics collection
    match /behavior_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // Rules for Web Vitals & Performance Telemetry
    match /vitals_logs/{vitalId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // Rules for Site Media & Permanent Photo Storage
    match /site_media/{mediaId} {
      allow read, write: if true;
    }

    match /stored_media/{mediaId} {
      allow read, write: if true;
    }
  }
}
