# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Hostinger SMTP Configuration
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="contato@triangulofotoclub.com.br"
SMTP_PASS="YOUR_SMTP_PASSWORD"
ADMIN_EMAIL="contato@triangulofotoclub.com.br"

# InfinitePay Configuration
INFINITEPAY_HANDLE="daluz_jef"
INFINITEPAY_API_KEY="YOUR_INFINITEPAY_API_KEY"

# Google Cloud Storage / Firebase Storage Bucket for Daily Backups
GCS_BUCKET_NAME="ai-studio-estudiotriangulo-backups"

